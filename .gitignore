# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
dist/
build/
*.egg-info/
*.egg

# Database files
*.db
*.db-shm
*.db-wal

# Environment
.env
.venv/
venv/

# IDE
.vscode/
.idea/


# OS
.DS_Store
Thumbs.db

# Testing
.pytest_cache/
.coverage
htmlcov/

# Linting. ruff writes this on every run, including from the pre-commit hook,
# so without it every contributor carries an untracked directory in `git
# status` and eventually somebody commits it.
.ruff_cache/

# Jupyter
.ipynb_checkpoints/

# Local operator notes and scratch scripts. These describe one particular
# two-laptop setup and carry its coordinator token, so they must never be
# published — keep them out of the repo rather than trusting them to be
# scrubbed before every commit.
HANDOFF.md
worker_fix.bat

# Internal operational notes (not for the repo)
WORK_LOG.md
.rel.json

# TLS material. `gpumesh serve --tls` keeps its generated pair under
# ~/.gpumesh/tls/, well outside the repo, so nothing here is produced by the
# tool itself. This block exists for the other case: an operator copying a
# certificate and its key into the working directory to test with, and then
# committing the key by reflex. A private key in git history is a rewrite,
# not a revert.
*.pem
*.key
*.pfx
*.p12
coordinator-cert.pem
coordinator-key.pem
