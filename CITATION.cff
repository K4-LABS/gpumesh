    family-names: Konar
    alias: Samurai007AK

version: 3.2.0
date-released: "2026-08-26"
license: Apache-2.0

repository-code: "https://github.com/K4-LABS/gpumesh"
url: "https://github.com/K4-LABS/gpumesh"
repository-artifact: "https://pypi.org/project/gpumesh/"

keywords:
  - gpu
  - distributed-computing
  - machine-learning
  - pytorch
  - cuda
  - python
  - task-scheduling
