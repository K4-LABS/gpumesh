    family-names: LAST-NAME-PLACEHOLDER
    alias: Samurai007AK
    # orcid: "https://orcid.org/0000-0000-0000-0000"

version: 3.0.0
date-released: "2026-08-18"
license: AGPL-3.0-or-later

