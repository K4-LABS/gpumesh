# =============================================================================
# gpumesh Docker Configuration
# Copy this file to .env and customize for your setup
# =============================================================================

# Authentication token for coordinator and workers
# Generate a secure token: python -c "import secrets; print(secrets.token_urlsafe(32))"
GPUMESH_TOKEN=your-secret-token-here

# Port for the coordinator HTTP API (default: 8732)
GPUMESH_PORT=8732

# Enable colored output (1 = yes, 0 = no)
GPUMESH_COLOR=1

# Number of worker replicas (only for docker-compose)
WORKER_REPLICAS=2

# Task timeout in seconds (default: 240)
# GPUMESH_TASK_TIMEOUT=240

# Safe mode: disable function distribution, scripts only (0 = no, 1 = yes)
# GPUMESH_SAFE_MODE=0

# Verbose logging (0 = no, 1 = yes)
# GPUMESH_VERBOSE=0
