# =============================================================================
# gpumesh Docker Configuration
# Copy this file to .env and customize for your setup
# =============================================================================

# Authentication token for coordinator and workers
# Generate a secure token: python -c "import secrets; print(secrets.token_urlsafe(32))"
GPUMESH_TOKEN=your-secret-token-here

# Port for the coordinator HTTP API (default: 8732)
GPUMESH_PORT=8732

# Enable colored output (1 = yes, 0 = no)
GPUMESH_COLOR=1

# Number of worker replicas (only for docker-compose)
WORKER_REPLICAS=2

# Task timeout in seconds (default: 240)
# GPUMESH_TASK_TIMEOUT=240

# Safe mode: disable function distribution, scripts only (0 = no, 1 = yes)
# GPUMESH_SAFE_MODE=0

# Verbose logging (0 = no, 1 = yes)
# GPUMESH_VERBOSE=0

# -----------------------------------------------------------------------------
# Security options
# -----------------------------------------------------------------------------

# Strict result deserialization (0 = no, 1 = yes).
# A worker's result is unpickled on the machine that collects it, and
# unpickling is code execution -- so a hostile worker runs code on YOU. Strict
# mode refuses to unpickle at all: JSON-encodable results still work, and
# anything else (a tensor, a numpy array, a DataFrame) raises instead of
# executing. That is a real restriction, not free hardening.
# GPUMESH_STRICT_RESULTS=0

# Token key derivation: pbkdf2_sha256 (default) or sha256 (legacy, one round).
# Only set this if you have measured the PBKDF2 cost and decided against it.
# Hashes in either format keep verifying regardless of what this is set to.
# GPUMESH_AUTH_KDF=pbkdf2_sha256

# PBKDF2 cost factor. Higher is slower to brute-force offline and slower to
# start. Successful verifications are cached in memory, so this is paid once
# per token rather than per request. Minimum 1000.
# GPUMESH_AUTH_KDF_ITERATIONS=200000

# -----------------------------------------------------------------------------
# TLS (client side)
# -----------------------------------------------------------------------------
# These are for containers CONNECTING to a coordinator started with --tls.
# The coordinator side is a flag, not an environment variable.

# Path to a copy of the coordinator's certificate. With this set, the
# coordinator is verified. This is the option worth using.
# GPUMESH_TLS_CA=/etc/gpumesh/coordinator-cert.pem

# Skip certificate verification (0 = no, 1 = yes). Traffic is still encrypted,
# but nothing checks who is on the other end: an attacker on the path can
# substitute their own certificate and read everything. Better than plain
# HTTP, worse than GPUMESH_TLS_CA above.
# GPUMESH_TLS_INSECURE=0
